rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.role in ['admin', 'superadmin'];
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['role', 'admin', 'permissions']);
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'role',
              'admin',
              'permissions',
              'basecampId',
              'email',
              'uid',
              'username',
              'usernameNormalized',
              'createdAt'
            ]));
      allow delete: if isAdmin();
    }

    match /basecamps/{basecampId} {
      allow read: if isAdmin() || resource.data.visibility == 'public';
      allow write: if isAdmin();
    }

    match /routes/{routeId} {
      allow read: if isAdmin() || resource.data.visibility == 'public';
      allow write: if isAdmin();
    }

    match /mountains/{mountainId} {
      allow read: if isAdmin() || resource.data.visibility == 'public';
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin() || resource.data.visibility == 'public';
      allow write: if isAdmin();
    }

    match /usernames/{username} {
      allow read, write: if false;
    }

    match /users/{userId}/checklist/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /registrations/{registrationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.groupSize is int
        && request.resource.data.groupSize >= 1
        && request.resource.data.groupSize <= 20
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.status == 'pending'
        && request.resource.data.ticketCode == null
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'ownerEmail',
          'ownerName',
          'mountainId',
          'mountainName',
          'startDate',
          'endDate',
          'groupSize',
          'emergencyContactName',
          'emergencyContactPhone',
          'notes',
          'status',
          'ticketCode',
          'createdAt',
          'updatedAt'
        ]);
      allow update, delete: if isAdmin();
    }

    match /documents/{documentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
