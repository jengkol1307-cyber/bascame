# Firebase client config (Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firebase Admin SDK service account credentials.
# Use the three FIREBASE_ADMIN_* variables, or the legacy JSON variable below.
# Never prefix credentials with NEXT_PUBLIC_ or commit real credentials.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Google Apps Script web app URL and the same private secret as GAS Script Property.
GAS_WEB_APP_URL=
GAS_SHARED_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=
